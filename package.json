{
  "name": "lab-harness",
  "version": "0.2.0",
  "description": "Offline terminal harness with owned Herdr processes, source-bound context, safe skill loading and explicit task acceptance",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "demo": "bun --no-env-file --no-install src/cli.ts demo",
    "test": "bun --no-env-file --no-install test ./tests",
    "typecheck": "bun --no-env-file --no-install ./node_modules/typescript/bin/tsc --noEmit",
    "check:publication": "bun --no-env-file --no-install scripts/check-publication.ts",
    "check": "bun --no-env-file run test && bun --no-env-file run typecheck && bun --no-env-file run check:publication",
    "setup:herdr": "bun --no-env-file --no-install scripts/herdr/acquire.ts",
    "smoke:herdr": "bun --no-env-file --no-install scripts/herdr/smoke.ts",
    "demo:terminal": "bun --no-env-file --no-install src/cli.ts terminal-demo",
    "benchmark:search": "bun --no-env-file --no-install scripts/benchmark-search.ts",
    "inventory:skills": "bun --no-env-file --no-install scripts/inventory-skills.ts",
    "refresh:publication": "bun --no-env-file --no-install scripts/refresh-publication.ts --reviewed-files",
    "check:actual": "LAB_HERDR_ACTUAL=1 bun --no-env-file run check",
    "header": "bun --no-env-file --no-install src/cli.ts header",
    "smoke:pi-ui": "bun --no-env-file --no-install src/cli.ts pi-ui-smoke",
    "check:brand": "bun --no-env-file --no-install scripts/pi/derive-terminal-mark.ts --check",
    "setup:rg": "bun --no-env-file --no-install scripts/acquire-rg.ts",
    "setup:pi": "bun --no-env-file --no-install scripts/pi/acquire.ts",
    "start": "./lab"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "bun-types": "1.4.4",
    "typescript": "7.0.2",
    "undici-types": "8.12.3"
  },
  "trustedDependencies": []
}
